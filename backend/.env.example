# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=study_connect_db
# Local development only; use false with reviewed migrations in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT Authentication
# Production requires a private random value of at least 32 characters.
JWT_SECRET=
JWT_EXPIRATION=7d

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=onboarding@resend.dev

# Throttling / Rate Limiting (1 request per 60s for OTP resends)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS
CORS_ORIGIN=https://peer-tutoring-platform-gamma.vercel.app/
access-control-allow-origin: *
